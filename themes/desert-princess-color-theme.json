    "terminal.ansiBrightGreen": "#e4d7f2",
    "terminal.ansiYellow": "#f2ba60",
    "terminal.ansiBrightYellow": "#f6cf90",
    "terminal.ansiBlue": "#43c7c7",
    "terminal.ansiBrightBlue": "#7bd8d8",
    "terminal.ansiMagenta": "#efd1ab",
    "terminal.ansiBrightMagenta": "#f4dfc4",
